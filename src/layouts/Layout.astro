---
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Portafolio profesional de Esteban Vidal, Desarrollador de Software. Proyectos, experiencia y soluciones de ingeniería."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://www.estebanvidal.dev').href;
const ogImageURL = 'https://www.estebanvidal.dev/assets/screenshot.jpg';
---

<!doctype html>
<html lang="es" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalURL} />
        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImageURL} />

        <!-- Structured Data / JSON-LD -->
        <script type="application/ld+json" is:inline>
          {
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Esteban Vidal",
            "jobTitle": "Desarrollador de Software",
            "url": "https://www.estebanvidal.dev/",
            "sameAs": [
              "https://github.com/Tebias-cloud",
              "https://www.linkedin.com/in/esteban-vidal-/"
            ],
            "description": "Portafolio profesional de Esteban Vidal, Desarrollador de Software enfocado en diseño e implementación de sistemas, aplicaciones web, bases de datos y soluciones digitales mantenibles."
          }
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">

        <script is:inline>
          // Sincronización inmediata de tema e idioma para evitar parpadeos
          try {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
              document.documentElement.classList.remove('dark');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }

            const lang = localStorage.getItem('lang');
            if (lang === 'EN') {
              document.documentElement.lang = 'en';
            } else {
              document.documentElement.lang = 'es';
            }
          } catch {}
        </script>
    </head>
    <body class="bg-zinc-50 dark:bg-[#0a0a0a] text-zinc-900 dark:text-zinc-100 font-['Inter',sans-serif] selection:bg-purple-500/30 overflow-x-hidden transition-[color,background-color] duration-300">
        <slot />
    </body>
</html>
