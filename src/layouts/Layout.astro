---
import '../styles/global.css'
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
    title: string;
    description?: string;
}

const { 
    title, 
    description = "Portafolio profesional de Esteban Vidal, Desarrollador de Software. Proyectos, experiencia y soluciones de ingeniería." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <meta name="description" content={description} />
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="/img/toxicskies1.webp" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content="/img/toxicskies1.webp" />

        <!-- Structured Data / JSON-LD -->
        <script type="application/ld+json" is:inline>
          {
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Esteban Vidal",
            "jobTitle": "Desarrollador de Software",
            "url": "https://tebias-cloud.github.io",
            "sameAs": [
              "https://github.com/Tebias-cloud"
            ],
            "description": "Portafolio profesional de Esteban Vidal, Desarrollador de Software con especialidad en Next.js, React, Astro y Unity."
          }
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
        
        <script is:inline>
          const theme = (() => {
            // 1. Si el usuario ya eligió un tema antes y quedó guardado, lo respetamos
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
              return localStorage.getItem('theme');
            }
            // 2. Si es su primera vez o está en incógnito, forzamos el modo oscuro siempre
            return 'dark';
          })();
          
          if (theme === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
            // Guardamos el modo oscuro como su nueva preferencia base
            window.localStorage.setItem('theme', 'dark');
          }
        </script>
    </head>
    <body class="bg-zinc-50 dark:bg-[#0a0a0a] text-zinc-900 dark:text-zinc-100 font-['Inter',sans-serif] selection:bg-purple-500/30 overflow-x-hidden transition-[color,background-color] duration-300">
        <slot />
        <SpeedInsights />
        
        <script>
          import { inject } from '@vercel/analytics';
          inject();
        </script>
    </body>
</html>